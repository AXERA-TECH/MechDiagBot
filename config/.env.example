# Cat Assistant — local environment overrides.
#
# Copy this file to a gitignored `.env` at the repo root (or point CAT_ENV_FILE
# at it) and fill in real values:
#
#     cp config/.env.example .env
#
# The CLI (`edgepilot`) and debug UI (`edgepilot-ui`) load `.env`
# automatically on startup. A variable already set in the real environment
# always wins, so `export`-ing still overrides the file. Never commit `.env`.

# --- Langfuse tracing (optional) -------------------------------------------
# Requires the optional extra:  pip install 'edgepilot-assistant[tracing]'
# Leave these unset to run with the zero-dependency no-op tracer.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
# Server URL. v4 uses LANGFUSE_BASE_URL (LANGFUSE_HOST is the deprecated alias).
# EU cloud (default): https://cloud.langfuse.com  ·  US cloud: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Model API key (optional) ----------------------------------------------
# Referenced by runtime-config "api_key_env"; the config stores only the NAME.
# CAT_API_KEY=sk-xxxxxxxxxxxxxxxx
